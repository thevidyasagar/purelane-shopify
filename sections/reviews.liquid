{% comment %}
  Reviews — matches #reviews in purelane-homepage.html.
  Auto-scrolling rail (CSS marquee), pauses on hover/focus, and
  disables animation entirely for prefers-reduced-motion. The track
  is duplicated once so the loop is seamless; each visible review
  is a block so a marketing team can add/edit/reorder without code.
{% endcomment %}

<section class="pl-sec pl-revband" id="reviews" data-scene="{{ section.settings.scene_number }}">
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {% if section.settings.kicker != blank %}
        <span class="pl-d4" style="color:var(--paper-3);letter-spacing:.14em;text-transform:uppercase;font-weight:700;font-size:11.5px">{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.rating_text != blank %}
        <span class="pl-agg"><span class="pl-st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
      {% endif %}
      {% if section.settings.homes_text != blank %}
        <span class="pl-agg">{{ section.settings.homes_text }}</span>
      {% endif %}
    </div>
  </div>

  {% assign review_blocks = section.blocks | where: 'type', 'review' %}
  {% if review_blocks.size > 0 %}
    <div class="pl-revrail pl-rv" aria-label="Customer reviews">
      <div class="pl-revtrack">
        {% comment %} render the set twice, back to back, for a seamless CSS marquee loop {% endcomment %}
        {% for pass in (1..2) %}
          {% for block in review_blocks %}
            <article class="pl-glass-2 pl-rcard" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %} {% if pass == 2 %}aria-hidden="true"{% endif %}>
              <div class="pl-st">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}
                {% endfor %}
              </div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.quote }}</p>
              <div class="pl-who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.reviewer_name }}</b>
                {% if block.settings.reviewer_context != blank %}<span>&middot; {{ block.settings.reviewer_context }}</span>{% endif %}
              </div>
            </article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "shopify-section-reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "That's what they said" },
    { "type": "text", "id": "rating_text", "label": "Rating summary text", "default": "4.8 from 8,000+ reviews" },
    { "type": "text", "id": "homes_text", "label": "Secondary stat text", "default": "Loved by 12 lakh+ homes" },
    {
      "type": "select",
      "id": "scene_number",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "Scene 1" },
        { "value": "2", "label": "Scene 2" },
        { "value": "3", "label": "Scene 3" },
        { "value": "4", "label": "Scene 4" }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title", "default": "Works like a charm" },
        { "type": "textarea", "id": "quote", "label": "Review text", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Anita" },
        { "type": "text", "id": "reviewer_context", "label": "Reviewer context", "info": "e.g. product bought", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "quote": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "reviewer_name": "Anita", "reviewer_context": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "reviewer_name": "Priya", "reviewer_context": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "quote": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "reviewer_name": "Sunita", "reviewer_context": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "quote": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "reviewer_name": "Rohit S.", "reviewer_context": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "quote": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "reviewer_name": "Verified buyer", "reviewer_context": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
