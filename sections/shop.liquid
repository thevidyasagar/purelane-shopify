{% comment %}
  Shop / product grid — matches #shop in purelane-homepage.html.
  Pulls REAL products from a merchant-selected collection so a
  marketing team can swap products without touching code.
{% endcomment %}

<section class="pl-sec" data-scene="{{ section.settings.scene_number }}" id="shop">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {% if section.settings.kicker != blank %}
        <span class="pl-d4" style="color:var(--paper-3);letter-spacing:.22em;text-transform:uppercase;font-weight:700;font-size:11px">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="pl-shelf">
      {% assign shop_collection = collections[section.settings.collection] %}
      {% if shop_collection != blank %}
        {% for card_product in shop_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card',
            product: card_product,
            pill_text: section.settings.default_pill,
            reveal_class: 'pl-rv' %}
        {% endfor %}
      {% else %}
        {% comment %} Editor placeholder so merchants see something before picking a collection {% endcomment %}
        {% for i in (1..4) %}
          <article class="pl-glass-2 pl-card">
            <div class="pl-shot"><span class="pl-noimg"><span>Select a collection</span></span></div>
            <h4>Product title</h4>
            <div class="pl-pr"><strong>₹0</strong></div>
            <button type="button" class="pl-btn pl-btn-ghost" disabled>Add to cart</button>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.view_all_text != blank and shop_collection != blank %}
      <div style="text-align:center;margin-top:28px">
        <a href="{{ shop_collection.url }}" class="pl-btn pl-btn-ghost">{{ section.settings.view_all_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "shopify-section-shop",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "text",
      "id": "default_pill",
      "label": "Default badge text",
      "info": "Shown on in-stock products unless you set per-product badges via a metafield later. Sold-out products always show \"Sold out\" automatically.",
      "default": "Best seller"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "\"View all\" button text",
      "default": "View all products"
    },
    {
      "type": "select",
      "id": "scene_number",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "Scene 1" },
        { "value": "2", "label": "Scene 2" },
        { "value": "3", "label": "Scene 3" },
        { "value": "4", "label": "Scene 4" }
      ],
      "default": "3"
    }
  ],
  "presets": [
    {
      "name": "Shop grid"
    }
  ]
}
{% endschema %}
